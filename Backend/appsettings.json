{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "AppDelivery.Api",
    "Audience": "AppDelivery.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "PasswordResetTokenMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "Routing": {
    "BaseUrl": "https://router.project-osrm.org/",
    "TimeoutSeconds": 8,
    "DefaultProfile": "driving"
  },
  "AllowedHosts": "*"
}
